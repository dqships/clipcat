{
  "name": "@clipcat/site",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "ClipCat's marketing site: a Next.js app with Markdown for agents, served by Vercel.",
  "scripts": {
    "dev": "node scripts/text-files.mjs && next dev",
    "build": "node scripts/text-files.mjs && next build",
    "start": "next start",
    "check": "next typegen && tsc --noEmit",
    "docs": "node scripts/docs.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "test:server": "SITE_URL=https://clipcat.example VERCEL_ENV=production npm run build && node --test \"test/server/*.test.mjs\"",
    "og": "node scripts/og.mjs"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "marked": "^18.1.2",
    "typescript": "~5.9.3"
  }
}
